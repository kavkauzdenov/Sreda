# Identity and business data are server-side. Never commit real values.
NEXT_PUBLIC_APP_NAME=БизнеСоты
NEXT_PUBLIC_DATA_SOURCE=api
# Explicit local-only demo: NEXT_PUBLIC_DATA_SOURCE=mock (ignored in production).
#
# Public origin of this deployment (exact origin, no path, no trailing slash).
# Local: http://localhost:3000
# Production canonical (ONLY after DNS + TLS ready): https://biznesoty.ru
#
# Alias brand hosts are redirect-only — do NOT set them as APP_URL and do NOT
# add them to Better Auth trustedOrigins:
#   biznesoty.online, www.biznesoty.online
#   www.biznesoty.ru
#   бизнесоты.рф (xn--90aifd0ahuj5f.xn--p1ai)
APP_URL=http://localhost:3000
DATABASE_URL=postgresql://biznesoty:replace_me@localhost:5432/biznesoty
# Generate at least 32 random bytes; no fallback secret exists.
BETTER_AUTH_SECRET=
# Dedicated AES key for Telegram/VK/Meta connection credentials.
# New ciphertext uses this key. Existing legacy v1 ciphertext remains readable
# through BETTER_AUTH_SECRET until it is naturally re-saved/re-encrypted.
CONNECTION_ENCRYPTION_KEY=
# Comma-separated old connection keys kept only during planned key rotation.
CONNECTION_ENCRYPTION_PREVIOUS_KEYS=
# Optional remote production backup target, e.g. s3://bucket/biznesoty.
BACKUP_S3_DESTINATION=
# Entitlement grant policy: closed_beta (manual/free activation) or paid.
# paid requires an active provider-backed subscription ledger entry.
BILLING_MODE=closed_beta
# Set true only where the independent background-worker process is actually running.
BACKGROUND_WORKER_ENABLED=false
# VK Callback API остаётся выключенным до подключения и проверки бота.
VK_WEBHOOKS_ENABLED=false
TELEGRAM_WEBHOOKS_ENABLED=false
# Public base URL that Telegram data centres must reach for POST
# /api/telegram/<connectionId>. Leave empty to publish the webhook on APP_URL.
# Set it only when APP_URL is not routable from Telegram and a relay host
# forwards that path to this app (exact origin, no path, no trailing slash).
TELEGRAM_WEBHOOK_BASE_URL=
# Meta WhatsApp Cloud API + Instagram Messaging (official Graph API only).
META_WEBHOOKS_ENABLED=false
WHATSAPP_WEBHOOKS_ENABLED=false
INSTAGRAM_WEBHOOKS_ENABLED=false
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
META_WHATSAPP_EMBEDDED_SIGNUP_CONFIG_ID=
META_INSTAGRAM_LOGIN_CONFIG_ID=
# Optional server-side post draft generation. Never use NEXT_PUBLIC_ for secrets.
AI_API_TOKEN=
AI_MODEL=
# Private S3-compatible bucket shared by web and all workers (AWS, Yandex, Selectel, MinIO).
ATTACHMENT_STORAGE=s3
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Local development alternative: ATTACHMENT_STORAGE=filesystem and absolute shared path.
ATTACHMENT_STORAGE_PATH=
