# Copy to /opt/biznesoty/app.env with mode 0600. Never commit real values.
# Exact origin of this deployment (no path, no trailing slash). Aliases are NOT APP_URL.
APP_URL=https://biznesoty.ru
NEXT_PUBLIC_APP_NAME=БизнеСоты
NEXT_PUBLIC_DATA_SOURCE=api
DATABASE_URL=postgresql://biznesoty:REPLACE_WITH_HEX_PASSWORD@db:5432/biznesoty
BETTER_AUTH_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
# Webhook flags: only the exact string "true" enables (see src/server/runtime.ts).
TELEGRAM_WEBHOOKS_ENABLED=false
VK_WEBHOOKS_ENABLED=false
# OSINT: VK API token for the "vk" discovery provider (groups.search).
# Empty value disables the provider (it is reported as unavailable, not an error).
OSINT_VK_API_TOKEN=
# Meta WhatsApp Cloud API + Instagram Messaging (official Graph API only).
# Meta outbox delivery runs inside telegram-worker — keep flags in sync with app.
META_WEBHOOKS_ENABLED=false
WHATSAPP_WEBHOOKS_ENABLED=false
INSTAGRAM_WEBHOOKS_ENABLED=false
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
META_WHATSAPP_EMBEDDED_SIGNUP_CONFIG_ID=
META_INSTAGRAM_LOGIN_CONFIG_ID=
AI_API_TOKEN=
AI_MODEL=
ATTACHMENT_STORAGE=s3
S3_ENDPOINT=https://storage.yandexcloud.net
S3_REGION=ru-central1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
